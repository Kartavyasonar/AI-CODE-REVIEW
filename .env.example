# ── Required ──────────────────────────────────────────────────────────────────
# Get your key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── Optional — security ────────────────────────────────────────────────────────
# If set, all POST /review requests must include header: x-api-key: <value>
# Leave blank to disable auth (fine for local dev, not for production)
API_SECRET=

# ── Optional — storage ────────────────────────────────────────────────────────
# Absolute path for the persistent memory store.
# On Railway/Render: set this to a mounted volume path, e.g. /data/memory_db
# Locally: leave blank to use ./memory_db (relative to working directory)
MEMORY_DB_DIR=./memory_db

# ChromaDB for per-review vector store (in-memory, no path needed)
# Kept here for documentation only — not currently used as env var
CHROMA_PERSIST_DIR=./chroma_db

# ── Server ─────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Set to your actual Vercel frontend URL in production.
# Example: https://my-code-review.vercel.app
# Leave blank or use * to allow all origins (fine for local dev)
FRONTEND_URL=*
